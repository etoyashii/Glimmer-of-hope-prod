        choices:
        - choiceText: 
          nextNodeId: row285_6d3c69a0
        editorPosition: {x: 83700, y: 380}
        speakerId: Menzo-Tari
        text: "Here, look. These are all the smoke geysers in the area. Three big
          pockets, there, there and there. That\u2019s where all this rising haze
          comes from."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
