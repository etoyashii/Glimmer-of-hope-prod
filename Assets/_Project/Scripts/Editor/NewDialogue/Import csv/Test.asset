          nextNodeId: row424_1d3ab0c3
        editorPosition: {x: 125400, y: 380}
        speakerId: Erba farmer
        text: "We\u2019re changing strategy: instead of adapting the climate to the
          plants, we\u2019ll adapt the plants to the climate. So we can pull up the
          old anti-smoke plants."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
