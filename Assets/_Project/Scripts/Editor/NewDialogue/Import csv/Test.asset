          nextNodeId: row106_550b554f
        editorPosition: {x: 30000, y: 380}
        speakerId: Glow
        text: "Happiness is different for everyone. Maybe George isn\u2019t short
          on food\u2026 but on a place that fits him."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
