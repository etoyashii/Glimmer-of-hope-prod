    - rid: 3506134116684530458
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: G 2.3.1 a) i
        choices:
        - choiceText: acknowledge the demand
          nextNodeId: G 2.3.1 a) i _c1
        - choiceText: look for a concrete solution
          nextNodeId: G 2.3.1 a) i _c2
        editorPosition: {x: 84900, y: 380}
        speakerId: Rebel miner (strike captain)
        text: "No one goes back down until we\u2019ve got what we need! Wood to shore
          up the mine, and food. Otherwise, the strike goes on!"
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 1
    - rid: 3506134116684530459
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: G 2.3.1 a) i _c1
        choices:
        - choiceText: 
          nextNodeId: row290_13ce86af
        editorPosition: {x: 85200, y: 380}
        speakerId: Player
        text: "You\u2019re right to ask for safe conditions. No one should work with
          their heart in their throat."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530460
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row290_13ce86af
        choices:
        - choiceText: 
          nextNodeId: G 2.3.1 a) i _cont
        editorPosition: {x: 85500, y: 380}
        speakerId: Rebel miner
        text: "\u2026At least someone gets it. It\u2019s not a tantrum, you know.
          We just want to work without risking our necks."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530461
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: G 2.3.1 a) i _c2
        choices:
        - choiceText: 
          nextNodeId: row292_fabf835d
        editorPosition: {x: 85800, y: 380}
        speakerId: Player
        text: "What if I brought you the wood and food myself \u2014 you call off
          the strike?"
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530462
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row292_fabf835d
        choices:
        - choiceText: 
          nextNodeId: G 2.3.1 a) i _cont
        editorPosition: {x: 86100, y: 380}
        speakerId: Rebel miner
        text: "Bring them first. Then we\u2019ll talk. But I\u2019m warning you:
          no empty promises."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
