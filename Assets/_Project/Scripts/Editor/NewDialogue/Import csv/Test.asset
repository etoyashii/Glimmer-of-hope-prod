        editorPosition: {x: 28500, y: 380}
        speakerId: Lily
        text: "Hi\u2026 I\u2019m Lily, and this is George."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530271
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row101_55afadf6
        choices:
        - choiceText: 
          nextNodeId: row102_87ad442c
        editorPosition: {x: 28800, y: 380}
        speakerId: Lily
        text: "He barely eats anymore. I don\u2019t understand\u2026 Is he sick,
          maybe? What\u2019s wrong, George?"
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
