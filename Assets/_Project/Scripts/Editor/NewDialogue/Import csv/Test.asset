        editorPosition: {x: 13473.159, y: 277.16473}
        speakerId: Phyto villager
        text: "Again! Our tools keep disappearing one by one. I bet it\u2019s that
          fox hanging around."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
