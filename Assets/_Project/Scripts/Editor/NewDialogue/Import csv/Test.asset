      data:
        nodeId: row34_4ea5d726
        choices:
        - choiceText: 
          nextNodeId: row35_0ee0327f
        editorPosition: {x: 8700, y: 380}
        speakerId: Player
        text: "That happens when we keep too much to ourselves. We\u2019ll help you
          see clearer \u2014 come here."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
