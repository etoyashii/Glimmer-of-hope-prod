    - rid: 3506134116684530292
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: G 1.5.5 a) i and ii
        choices:
        - choiceText: 
          nextNodeId: row123_e82adec3
        editorPosition: {x: 35100, y: 380}
        speakerId: Tom
        text: "Your Jemytos eat our fruit! We farm for them, and get nothing back!
          It\u2019s not our job to feed them for you!"
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530293
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row123_e82adec3
        choices:
        - choiceText: 
          nextNodeId: row124_8280613f
        editorPosition: {x: 35400, y: 380}
        speakerId: Harry
        text: "We\u2019re just asking for fairness! We\u2019re the ones keeping the
          incinerator running for everyone. And what do we get? Blame?!"
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530294
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row124_8280613f
        choices:
        - choiceText: 
          nextNodeId: row125_46a8838f
        editorPosition: {x: 35700, y: 380}
        speakerId: Player
        text: What if we talked this through together, to find a solution?
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530295
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row125_46a8838f
        choices:
        - choiceText: 
          nextNodeId: row126_e9cca603
        editorPosition: {x: 36000, y: 380}
        speakerId: Tom
        text: "No. It\u2019s always the same. The Ytorales only see their own needs!"
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530296
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row126_e9cca603
        choices:
        - choiceText: 
          nextNodeId: row127_2de10cfe
        editorPosition: {x: 36300, y: 380}
        speakerId: Harry
        text: "Always the same complaints! You see what we don\u2019t do, never what
          we do."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
