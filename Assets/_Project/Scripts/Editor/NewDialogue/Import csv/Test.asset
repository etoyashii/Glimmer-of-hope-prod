        editorPosition: {x: 120300, y: 380}
        speakerId: Erba chief
        text: "The fog has lifted, true\u2026 but there\u2019s still this smoke rising
          from who-knows-where. We need to find where it\u2019s coming from."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530577
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row407_50da171b
        choices:
        - choiceText: 
          nextNodeId: row408_015e3554
        editorPosition: {x: 120600, y: 380}
        speakerId: Player
        text: "We\u2019ll trace it together. It\u2019s surely coming from lower down,
          over by the volcano."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
