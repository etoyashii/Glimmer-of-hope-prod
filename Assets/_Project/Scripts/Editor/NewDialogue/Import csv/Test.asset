        choices:
        - choiceText: 
          nextNodeId: row105_e87ab4b0
        editorPosition: {x: 29700, y: 380}
        speakerId: Player
        text: What if we asked ourselves, together, what a frog needs to be happy?
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
