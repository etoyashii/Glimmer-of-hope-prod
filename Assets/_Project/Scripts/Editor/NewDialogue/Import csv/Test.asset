    - rid: 3506134116684530583
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: G 3.6.2 a) i _give
        choices:
        - choiceText: 
          nextNodeId: row414_bf4d2ad9
        editorPosition: {x: 122400, y: 380}
        speakerId: Erba chief
        text: "Before we stop warming the biome, I want to be sure everyone\u2019s
          back. Some villagers got lost in the fog\u2026 we don\u2019t leave anyone
          out there."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530584
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row414_bf4d2ad9
        choices:
        - choiceText: 
          nextNodeId: row415_741b437b
        editorPosition: {x: 122700, y: 380}
        speakerId: Player
        text: "Agreed. We cut nothing until everyone\u2019s safe. I\u2019ll go find
          them."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530585
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row415_741b437b
        choices:
        - choiceText: 
          nextNodeId: row416_f593661d
        editorPosition: {x: 123000, y: 380}
        speakerId: Glow
        text: "He puts his people before efficiency. That\u2019s what caring for
          a community looks like."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530586
      type: {class: ActionNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
