        choices:
        - choiceText: 
          nextNodeId: row286_f6dda5ce
        editorPosition: {x: 84000, y: 380}
        speakerId: Player
        text: "Got it. Three sources. We\u2019ll deal with them one by one."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
