          nextNodeId: row167_0ee616d9
        editorPosition: {x: 48300, y: 380}
        speakerId: Player
        text: "I\u2019m not scared. Hang on, I\u2019ve got this."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
