          nextNodeId: row53_7b261bb3
        editorPosition: {x: 13773.158, y: 277.16473}
        speakerId: Player
        text: "Before we accuse it, we should figure out why it\u2019s doing this.
          An animal doesn\u2019t steal for nothing."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
