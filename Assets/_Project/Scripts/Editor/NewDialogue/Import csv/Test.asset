        nodeId: row102_87ad442c
        choices:
        - choiceText: 
          nextNodeId: row103_ac4d9b7c
        editorPosition: {x: 29100, y: 380}
        speakerId: Player
        text: "Maybe something\u2019s missing for him to feel okay?"
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530273
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row103_ac4d9b7c
        choices:
        - choiceText: 
          nextNodeId: row104_d8e6fb79
        editorPosition: {x: 29400, y: 380}
        speakerId: Lily
        text: "Yes\u2026 but what? He was always cheerful before."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530274
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
