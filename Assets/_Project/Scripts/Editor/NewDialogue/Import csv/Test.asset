        choices:
        - choiceText: 
          nextNodeId: row409_834808ce
        editorPosition: {x: 120900, y: 380}
        speakerId: Erba chief
        text: Thank you for taking this seriously. We felt a bit alone facing it.
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
