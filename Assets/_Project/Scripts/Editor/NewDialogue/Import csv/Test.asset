        choices:
        - choiceText: 
          nextNodeId: row168_bb050968
        editorPosition: {x: 48600, y: 380}
        speakerId: Foliage ball (Glow)
        text: "Ahh, I can breathe! Thanks for daring to come over. The others only
          saw how I looked\u2026 you saw what was underneath."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
