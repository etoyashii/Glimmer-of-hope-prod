    - rid: 3506134116684530170
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: L 1.1.1
        choices:
        - choiceText: 
          nextNodeId: row1_9e20b5fc
        editorPosition: {x: 300, y: 0}
        speakerId: Glow
        text: "Hey, you\u2019re back! It\u2019s me, Glow. Say\u2026 your drum, do
          you know where it went? I\u2019ve been looking everywhere."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530171
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row1_9e20b5fc
        choices:
        - choiceText: 
          nextNodeId: row2_9e03fdf4
        editorPosition: {x: 600, y: 0}
        speakerId: Player
        text: "My drum? Sure, I\u2019ll help you find it."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530172
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row2_9e03fdf4
        choices:
        - choiceText: 
          nextNodeId: row3_24d15650
        editorPosition: {x: 900, y: 0}
        speakerId: Glow
        text: "Perfect. Let\u2019s start by checking around that stele over there."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530173
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row3_24d15650
        choices:
        - choiceText: 
          nextNodeId: row4_5ebfe573
        editorPosition: {x: 1200, y: 0}
        speakerId: Glow
        text: "There it is! It was right there. See\u2026 it never really left you."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530174
      type: {class: EndNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row4_5ebfe573
        choices: []
        editorPosition: {x: 1500, y: 0}
        outcomeId: neutral
    - rid: 3506134116684530175
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: L 1.1.2
        choices:
        - choiceText: 
          nextNodeId: row6_0514cfc0
        editorPosition: {x: 0, y: 380}
        speakerId: Glow
        text: "Your drum has three notes. Try mixing them into little melodies\u2026
          you might wake up things you already knew."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530176
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row6_0514cfc0
        choices:
        - choiceText: 
          nextNodeId: row7_d3b37e85
        editorPosition: {x: 300, y: 380}
        speakerId: Glow
        text: "You\u2019ll relearn as you go. These steles hold rhythms in memory
          \u2014 they\u2019ll point the way. Take your time: watch, and listen."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
