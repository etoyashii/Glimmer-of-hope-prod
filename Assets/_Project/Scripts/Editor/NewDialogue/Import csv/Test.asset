          nextNodeId: row36_7f7dd673
        editorPosition: {x: 9000, y: 380}
        speakerId: Phyto villager
        text: "Oh\u2026 that feels good. Thank you. I\u2019d forgotten it could come
          back."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530206
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
