        choices:
        - choiceText: 
          nextNodeId: row130_c13665ed
        editorPosition: {x: 37200, y: 380}
        speakerId: Glow
        text: "To move forward, use your emotional sensitivity: try to feel what
          they\u2019re really going through. Listening is often the first step to
          calming things."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530300
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row130_c13665ed
        choices:
        - choiceText: 
          nextNodeId: row131_88129d78
        editorPosition: {x: 37500, y: 380}
        speakerId: Glow
        text: "There \u2014 you see: Tom\u2019s anger hides real frustration. And
          Harry feels deeply misunderstood. Peace starts with that understanding,
          not with accusations."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
