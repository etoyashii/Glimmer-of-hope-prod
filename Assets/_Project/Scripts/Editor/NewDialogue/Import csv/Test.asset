          nextNodeId: row163_cd337f07
        editorPosition: {x: 47100, y: 380}
        speakerId: Glow
        text: "A shelter, some company\u2026 sometimes that\u2019s all it takes for
          sadness to make room for joy."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
