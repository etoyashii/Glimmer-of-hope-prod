        editorPosition: {x: 90600, y: 380}
        speakerId: Menzo-Tari courier
        text: "No fruit falls from the sky anymore\u2026 Without supplies, I can\u2019t
          feed the miners. What am I supposed to tell them?"
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
