          nextNodeId: row166_e66edf23
        editorPosition: {x: 48000, y: 380}
        speakerId: Foliage ball (Glow)
        text: "All this foliage is smothering me\u2026 I wish someone would clear
          it off, but everyone\u2019s scared to come near!"
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
