        editorPosition: {x: 8400, y: 380}
        speakerId: Phyto villager
        text: "I\u2026 I don\u2019t know what\u2019s happening to me. My hand has
          gone all grey. Like a part of me switched off."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530204
