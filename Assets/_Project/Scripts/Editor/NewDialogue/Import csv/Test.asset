        choices:
        - choiceText: 
          nextNodeId: row419_75244fa3
        editorPosition: {x: 123900, y: 380}
        speakerId: Erba farmer
        text: "Once everyone\u2019s safe, we\u2019ll have to stop the heat generators\u2026
          even if it stings to switch off what we worked so hard to switch on."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530589
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row419_75244fa3
        choices:
        - choiceText: 
          nextNodeId: row420_1445489e
        editorPosition: {x: 124200, y: 380}
        speakerId: Player
        text: I get it. But warming without end melts the snow and floods the water
          lower down. Stopping now is the right move.
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530590
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row420_1445489e
        choices:
        - choiceText: 
          nextNodeId: row421_02488a62
        editorPosition: {x: 124500, y: 380}
        speakerId: Glow
        text: "Giving up what you built, when it\u2019s become necessary, takes courage.
          Stay by his side."
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 0
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 3506134116684530591
