/* ============================================
   Dialogue Graph Editor — Styles
   ============================================ */

/* --- Grid Background --- */
GridBackground {
    --grid-background-color: #1a1a1a;
    --line-color: #2a2a2a;
    --thick-line-color: #333333;
    --spacing: 50;
}

/* --- Start Node --- */
.start-node #title {
    background-color: #2d7a2d;
    border-bottom-width: 2px;
    border-bottom-color: #3da63d;
}

.start-node #title Label {
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
}

.start-node__info {
    padding: 8px;
}

.start-node__label {
    font-size: 11px;
    color: #bbbbbb;
    margin-bottom: 2px;
}

/* --- End Node --- */
.end-node #title {
    background-color: #8a2a2a;
    border-bottom-width: 2px;
    border-bottom-color: #b33a3a;
}

.end-node #title Label {
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
}

.end-node__label {
    padding: 8px;
    font-size: 11px;
    color: #999999;
    -unity-font-style: italic;
}

/* --- Dialogue Line Node --- */
.dialogue-line-node #title {
    background-color: #2a4a6a;
    border-bottom-width: 2px;
    border-bottom-color: #3a6a9a;
}

.dialogue-line-node #title Label {
    color: #ffffff;
    font-size: 12px;
}

.dialogue-line-node__body {
    padding: 6px 8px;
    min-width: 250px;
}

.dialogue-line-node__speaker {
    font-size: 11px;
    color: #7ac5ff;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.dialogue-line-node__emotion {
    font-size: 10px;
    color: #aaaaaa;
    margin-bottom: 4px;
}

.dialogue-line-node__text {
    font-size: 12px;
    color: #e0e0e0;
    padding: 4px 6px;
    margin-top: 2px;
    margin-bottom: 4px;
    background-color: #1e1e1e;
    border-radius: 3px;
    border-width: 1px;
    border-color: #3a3a3a;
    min-height: 30px;
}

.dialogue-line-node__text--empty {
    color: #666666;
    -unity-font-style: italic;
}

.dialogue-line-node__timing {
    font-size: 10px;
    color: #999999;
    margin-top: 2px;
}

.dialogue-line-node__actions {
    font-size: 10px;
    color: #c8a060;
    margin-top: 2px;
}

/* --- Choice Ports --- */
.dialogue-line-node__choices {
    margin-top: 4px;
    border-top-width: 1px;
    border-top-color: #3a3a3a;
    padding-top: 4px;
}

/* --- Condition Ports --- */
.dialogue-line-node__conditions {
    margin-top: 2px;
    border-top-width: 1px;
    border-top-color: #3a3a3a;
    padding-top: 4px;
}

/* --- Edges --- */
.dialogue-edge {
    --edge-width: 2;
}

/* --- Toolbar --- */
.graph-toolbar {
    border-bottom-width: 1px;
    border-bottom-color: #111111;
}

/* --- Node Selection --- */
.dialogue-line-node:checked #title {
    background-color: #3a6a9a;
    border-bottom-color: #5a9ada;
}

.start-node:checked #title {
    background-color: #3da63d;
    border-bottom-color: #5dc65d;
}

.end-node:checked #title {
    background-color: #b33a3a;
    border-bottom-color: #d35a5a;
}

/* --- Preview Active Node --- */
.preview-active {
    border-width: 3px;
    border-color: #ffcc00;
    border-radius: 6px;
}

.preview-active #title {
    background-color: #665500;
    border-bottom-color: #ffcc00;
}

/* --- Validation Error --- */
.validation-error {
    border-width: 2px;
    border-color: #ff3333;
}

.validation-warning {
    border-width: 2px;
    border-color: #ffaa33;
}
