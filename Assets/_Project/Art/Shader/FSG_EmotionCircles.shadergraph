    "m_SourceType": 1,
    "m_FunctionName": "WorldFromDepth",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if UNITY_REVERSED_Z\r\n    // depth déjà dans le bon sens\r\n#else\r\n    RawDepth = lerp(UNITY_NEAR_CLIP_VALUE, 1, RawDepth);\r\n#endif\r\nWorldPos = ComputeWorldSpacePosition(UV, RawDepth, UNITY_MATRIX_I_VP);"
}

