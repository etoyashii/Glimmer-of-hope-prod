        editorPosition: {x: 300, y: 0}
        speakerId: Adrien
        text: "I\u2019m missing five flowers for my collection\u2026 I\u2019ve been
          searching for a while, but I can\u2019t find a single one. What\u2019s
          the point of carrying on?"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
