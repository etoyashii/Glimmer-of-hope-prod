        editorPosition: {x: -1024.1484, y: 63.01833}
        speakerId: Glow
        text: "Two accounts, two needs. Go see the systems for yourself before you
          go back to them. Harry feels misunderstood. To grasp the whole story, go
          see the incinerator with your own eyes: you\u2019ll understand how important
          it is for everyone."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row0_e4db4298
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
