            m_LocalVariables: []
          nextNodeId: row1_1d93c1b7
        editorPosition: {x: -98.14387, y: -10.664076}
        speakerId: Player
        text: "Harry, I\u2019d like to understand what\u2019s going on on your side.
          Do you want to tell me about it?"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row0_d2399bb1
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 383362646436741538
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row1_1d93c1b7
        choices:
        - choiceText: What would you like the Phytos to understand?
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row1_1d93c1b7_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: harry_need
        - choiceText: "And the Phytos\u2019 harvests, have you seen what\u2019s happening
            to them?"
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row1_1d93c1b7_1
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: harry_harvests
        - choiceText: Can you show me how the incinerator powers the portal?
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row1_1d93c1b7_2
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: harry_incinerator
        - choiceText: Would you be okay with picking up the conversation with Tom
            again?
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row1_1d93c1b7_3
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: harry_wrap
        editorPosition: {x: 203.55873, y: 471.06573}
        speakerId: Harry
        text: "We keep the incinerator running for everyone. Without it, the Portal
          of Renewal wouldn\u2019t work. But I feel like nobody sees that work, and
          all anyone sees is what we do wrong."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row1_1d93c1b7
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 1
    - rid: 383362646436741539
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: harry_need
        choices:
        - choiceText: 
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_harry_need_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: row3_ae4a550a
        editorPosition: {x: 588.8289, y: -624.20404}
        speakerId: Harry
        text: "All the work it takes. The wood to bring in, the water to keep an
          eye on\u2026 It doesn\u2019t run by itself."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_harry_need
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
