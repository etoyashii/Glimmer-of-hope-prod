      data:
        nodeId: harry_shown
        choices:
        - choiceText: What would you like the Phytos to understand?
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_harry_shown_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: harry_need
        - choiceText: "And the Phytos\u2019 harvests, have you seen what\u2019s happening
            to them?"
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_harry_shown_1
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: harry_harvests
        - choiceText: Can you show me how the incinerator powers the portal?
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_harry_shown_2
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: harry_incinerator
        - choiceText: Would you be okay with picking up the conversation with Tom
            again?
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_harry_shown_3
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: harry_wrap
        editorPosition: {x: 1717.0334, y: 532.18005}
        speakerId: Harry
        text: "That\u2019s what keeps the Portal of Renewal running."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
