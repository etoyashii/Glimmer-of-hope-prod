            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: hub
        editorPosition: {x: 1087.088, y: 436.7052}
        speakerId: Harry (hesitates)
        text: "Not enough, probably. We mostly only end up talking when we\u2019re
          already angry."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
