    - rid: 383362646436741513
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row2_861aaf5f
        choices:
        - choiceText: "Tom seems really frustrated. He keeps coming back to the fruit
            they\u2019re missing."
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row2_861aaf5f_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: listen_separately
        - choiceText: Harry keeps stressing all the work they do. Maybe he feels
            nobody notices it.
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row2_861aaf5f_1
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: listen_separately
        - choiceText: "I can see they\u2019re angry\u2026 but I don\u2019t know what\u2019s
            behind it."
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row2_861aaf5f_2
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: unsure
        editorPosition: {x: 966.9185, y: -9.125254}
        speakerId: Lueur
        text: What do you notice?
        localizedText:
          m_TableReference:
