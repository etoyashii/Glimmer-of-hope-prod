            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: row3_d5443755
        editorPosition: {x: 435.0598, y: -412.44278}
        speakerId: Harry
        text: "Yes. We could start by looking at what\u2019s left on your trees and
