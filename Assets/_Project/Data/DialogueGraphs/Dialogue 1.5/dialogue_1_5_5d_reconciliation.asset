        editorPosition: {x: 893.34094, y: -356.7972}
        speakerId: Tom (thinking)
        text: "All right\u2026 Harry, I understand better now that the incinerator
          serves everyone. But on our side, the fruit is really starting to run short.
          Can we figure out together how to keep too many J\xE9mytos from coming
          to feed at our place?"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
