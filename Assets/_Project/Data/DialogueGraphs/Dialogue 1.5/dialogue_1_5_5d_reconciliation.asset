            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: row2_4b8579eb
        editorPosition: {x: -139.33464, y: 459.9907}
        speakerId: Tom
        text: "I understand better why the incinerator matters to everyone. On our
          side, we\u2019re really starting to run out of fruit. Can we work out together
          how to feed the J\xE9mytos while keeping enough fruit for ourselves?"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row1_0cc8f5cc
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 383362646436741556
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
