          nextNodeId: row2_2049f3dc
        editorPosition: {x: -6.190806, y: -7.9101644}
        speakerId: Greg
        text: "We\u2019d like to\u2026 but the forest is starting to go dull, and
          so are our wood stores. We\u2019ve tried everything, but nothing works\u2026
          As long as our stores are dull, we won\u2019t have any wood to give you."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row1_a6c8df9b
