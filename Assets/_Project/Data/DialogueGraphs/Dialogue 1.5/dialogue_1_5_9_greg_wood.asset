          nextNodeId: row2_429902b1
        editorPosition: {x: -989.0439, y: 72.165726}
        speakerId: Greg (worried)
        text: "Yes, of course \u2014 the trouble is the forest is starting to dull,
          and so are our wood reserves. We\u2019ve tried everything, but nothing
          works\u2026 As long as our wood reserves stay dull, we won\u2019t have
          any wood to give you."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row1_6a834837
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
