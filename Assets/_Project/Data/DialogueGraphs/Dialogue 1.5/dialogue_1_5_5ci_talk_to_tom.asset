            m_LocalVariables: []
          nextNodeId: row2_f07819a3
        editorPosition: {x: -299.5932, y: 340.79108}
        speakerId: Tom
        text: "Yes, that\u2019s it!"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
