          nextNodeId: row4_7562eb04
        editorPosition: {x: 1477.567, y: -245.38564}
        speakerId: Tom
        text: This has been going on for too long! The Ytorales only see their own
          needs!
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
