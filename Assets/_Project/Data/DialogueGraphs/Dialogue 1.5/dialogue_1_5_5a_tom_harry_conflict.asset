        editorPosition: {x: 300, y: 0}
        speakerId: Tom
        text: "Your J\xE9mytos are eating our fruit, and now we\u2019re starting
          to run out! Are you going to do something about it?"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
