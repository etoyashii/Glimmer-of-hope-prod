            m_LocalVariables: []
          nextNodeId: row2_652d5bd9
        editorPosition: {x: 467.25034, y: -270.8628}
        speakerId: Harry
        text: And we keep the incinerator running for everyone! Do you know how much
          work that takes? It feels like nobody sees it. And what do we get? Complaints!
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row1_6494071e
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 383362646436741504
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row2_652d5bd9
        choices:
        - choiceText: 
          localizedChoiceText:
            m_TableReference:
