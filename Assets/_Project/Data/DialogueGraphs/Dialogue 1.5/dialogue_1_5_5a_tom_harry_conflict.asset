            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row2_652d5bd9_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: row3_62b2cb7a
        editorPosition: {x: 560.751, y: 293.6581}
        speakerId: Player
        text: "Wait\u2026 Tom, you\u2019re talking about the harvests. Harry, you\u2019re
          talking about the work at the incinerator. Can we listen to you one at
          a time?"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
