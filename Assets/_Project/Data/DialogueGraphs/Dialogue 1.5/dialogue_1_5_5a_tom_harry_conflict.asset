        editorPosition: {x: -78.135254, y: 661.066}
        speakerId: Tom (annoyed)
        text: "Your J\xE9mytos are eating our fruit! We grow it for them, and now
          we\u2019re the ones starting to run short. It\u2019s not our job to feed
          them for you!"
