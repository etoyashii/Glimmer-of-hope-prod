          nextNodeId: row12_bdd913ef
        editorPosition: {x: 3873.4204, y: 377.48206}
        speakerId: Phyto protesters
        text: We need our fruit too!
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row11_15893375
          m_FallbackState: 0
          m_WaitForCompletion: 0
