        editorPosition: {x: 2769.9602, y: 289.1689}
        speakerId: Lueur
        text: "Let\u2019s listen to them."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
