            m_LocalVariables: []
          nextNodeId: row2_070aa8f2
        editorPosition: {x: 65.97012, y: -20.988054}
        speakerId: Player
        text: "The J\xE9mytos? The Ytorales? Who are they?"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row1_011166fd
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
