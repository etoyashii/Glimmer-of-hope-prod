        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 383362646436741236
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row2_070aa8f2
        choices:
        - choiceText: 
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row2_070aa8f2_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: row3_b5098796
        editorPosition: {x: 404.44818, y: 239.0309}
        speakerId: Lueur
        text: The Phytos and the Ytorales come from the same people, the Ytos. They
          used to live together. Now they talk to each other less and less.
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row2_070aa8f2
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 383362646436741237
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row3_b5098796
        choices:
        - choiceText: 
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row3_b5098796_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: row4_51dcdc37
        editorPosition: {x: 1200, y: 0}
        speakerId: Player
        text: "And the J\xE9mytos?"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row3_b5098796
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 383362646436741238
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row4_51dcdc37
        choices:
        - choiceText: 
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row4_51dcdc37_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: row5_f0a54dbf
        editorPosition: {x: 1372.9054, y: 275.17694}
        speakerId: Lueur
        text: "They\u2019re little creatures that come out of the Portal of Renewal.
          When a J\xE9myto eats a fruit, it becomes a little Yto."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row4_51dcdc37
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 383362646436741239
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row5_f0a54dbf
        choices:
        - choiceText: 
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row5_f0a54dbf_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: row6_3edbce39
        editorPosition: {x: 1800, y: 0}
        speakerId: Player
        text: "So they\u2019re the future inhabitants of both villages?"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row5_f0a54dbf
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 383362646436741240
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row6_3edbce39
        choices:
        - choiceText: 
