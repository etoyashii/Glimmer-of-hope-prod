      data:
        nodeId: row17_250b625c
        choices:
        - choiceText: "We could follow the J\xE9mytos\u2019 route to understand what
            brings them this way."
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
