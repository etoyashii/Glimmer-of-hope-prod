            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: route
        editorPosition: {x: 6942.356, y: -397.85648}
        speakerId: Player
        text: "Someone could go and meet them, and look at the route the J\xE9mytos
          take."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
