            m_LocalVariables: []
          nextNodeId: row7_3a8682b3
        editorPosition: {x: 2186.2844, y: 293.83304}
        speakerId: Lueur
        text: Yes. And the portal runs on the wood the Ytorales burn in their incinerator.
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
