            m_LocalVariables: []
          nextNodeId: row1_f82fe9df
        editorPosition: {x: 187.498, y: -328.50192}
        speakerId: "M\u011Bi"
        text: "My fruit fell down the well\u2026 I tripped over this pot. And I scraped
          my leg!"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row0_78895522
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 383362646436741286
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: row1_f82fe9df
        choices:
        - choiceText: You look really angry.
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row1_f82fe9df_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: anger
        - choiceText: 'What bothers you most: your leg or the lost fruit?'
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row1_f82fe9df_1
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: matters
        - choiceText: Do you think smashing the pot would fix anything?
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row1_f82fe9df_2
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: smash
        editorPosition: {x: 370.2972, y: -74.62425}
        speakerId: "M\u011Bi"
        text: It should end up at the bottom of the well too!
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row1_f82fe9df
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 1
    - rid: 383362646436741287
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
