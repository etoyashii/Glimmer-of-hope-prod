            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: a2d9662c
        editorPosition: {x: -3372, y: -79}
        speakerId: Glow
        text: "This disease turns all matter fade and monochrome. It spreads so fast\u2026"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_f4923031
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
        followSpeaker: 0
