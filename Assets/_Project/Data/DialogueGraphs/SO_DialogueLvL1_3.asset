            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_fb59ee18_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: 65252705
        editorPosition: {x: -1647, y: -82}
        speakerId: Glow
        text: "This tree is the world-tree you\u2019re currently walking on. Its
          sap, the sap of hope, nourishes the plants of this reality!"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
