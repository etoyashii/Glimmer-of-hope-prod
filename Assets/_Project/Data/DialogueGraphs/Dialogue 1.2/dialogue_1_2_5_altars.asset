        editorPosition: {x: 307.47522, y: -0.6649763}
        speakerId: Glow (reminiscing)
        text: "These pedestals... they are altars. They were made to receive offerings
          to the Cirjos, the deities your people once believed in. I didn\u2019t
          think anyone still remembered them. If we place a fruit on each one, they
          might open the way for us. Now we just need to find the fruits\u2026"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
