        editorPosition: {x: 3942.4001, y: 15.199982}
        speakerId: Glow
        text: I know the World-Tree seems immense. But together, we can help it.
          One small step at a time.
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
