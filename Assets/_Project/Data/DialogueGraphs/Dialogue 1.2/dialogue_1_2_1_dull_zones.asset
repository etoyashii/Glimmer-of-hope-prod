        editorPosition: {x: 1167.8352, y: 252.16731}
        speakerId: Lueur
        text: "More and more parts of the World Tree are turning dull. The inhabitants
          call it the Monochronite. We don\u2019t understand everything that\u2019s
          going on yet."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
