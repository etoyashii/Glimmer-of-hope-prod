              m_KeyId: 0
              m_Key: choice_wt_ask_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: continue_a
        editorPosition: {x: 3255.2002, y: -188.8}
        speakerId: Glow (enthusiastic)
        text: "Yes, it\u2019s what we\u2019re walking on right now. Its sap, filled
          with hope, nourishes everything that exists."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
