          nextNodeId: 60e04103
        editorPosition: {x: 682.8133, y: -6.3678417}
        speakerId: Glow (approaches a gray zone)
        text: It looks like the World-Tree is losing its colors here too. There have
          been more and more dull zones like this lately. The inhabitants call it
          Monochronite.
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
            m_Key: line_row1_5c5fd1bd
          m_FallbackState: 0
          m_WaitForCompletion: 0
          m_LocalVariables: []
        bubblePrefab: {fileID: 0}
        followSpeaker: 0
        bubbleOffset: {x: 0, y: 2, z: 0}
        useTypewriter: 1
        typewriterCharsPerSecond: 30
        hasChoices: 0
    - rid: 8558608729178636395
      type: {class: DialogueLineNode, ns: GlimmerOfHope.Gameplay.NewDialogue, asm: GlimmerOfHope.Gameplay}
      data:
        nodeId: wt_ask
        choices:
        - choiceText: 
          localizedChoiceText:
