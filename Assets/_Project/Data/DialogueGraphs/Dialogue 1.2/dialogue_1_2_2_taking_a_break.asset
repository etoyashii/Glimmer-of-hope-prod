            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: hurry_a
        editorPosition: {x: 2086.4, y: 23.199982}
        speakerId: Glow
        text: "Don\u2019t worry. We\u2019re not in a rush\u2014it\u2019s been years
          since Monochronite has been eating away at the World-Tree. Taking a break
          helps solidify what we\u2019ve just learned, and in the end, we\u2019ll
          save time."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
