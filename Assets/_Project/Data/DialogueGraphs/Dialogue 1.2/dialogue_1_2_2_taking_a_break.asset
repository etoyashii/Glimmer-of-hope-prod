      data:
        nodeId: row0_4c8255a2
        choices:
        - choiceText: Yes, a short break would do me good.
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row0_4c8255a2_0
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: sit
        - choiceText: "But\u2026 shouldn\u2019t we keep moving?"
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row0_4c8255a2_1
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: hesitate
        - choiceText: I feel great. I want to keep going!
          localizedChoiceText:
            m_TableReference:
              m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
            m_TableEntryReference:
              m_KeyId: 0
              m_Key: choice_row0_4c8255a2_2
            m_FallbackState: 0
            m_WaitForCompletion: 0
            m_LocalVariables: []
          nextNodeId: explore
        editorPosition: {x: 207.70242, y: -282.33472}
        speakerId: Lueur
        text: "We\u2019ll need to figure out how to get across. Want to take a breather?
