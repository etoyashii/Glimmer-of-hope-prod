        editorPosition: {x: 300, y: 0}
        speakerId: Glow (calm)
        text: "And there you go, another dull zone healed! We could take a moment
          to breathe\u2014what do you think? There\u2019s a bench right there."
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
