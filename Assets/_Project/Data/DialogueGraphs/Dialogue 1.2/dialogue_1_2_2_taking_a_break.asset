          nextNodeId: break_a
        editorPosition: {x: 2084, y: -193.344}
        speakerId: Glow
        text: "Perfect. Taking a break helps solidify what we\u2019ve just learned.
          Let\u2019s sit down and recap: how do we heal a dull zone\u2026 and how
          could we cross that lake?"
        localizedText:
          m_TableReference:
            m_TableCollectionName: GUID:f8fabd72a30bffb479f5f15b97ffd357
          m_TableEntryReference:
            m_KeyId: 0
