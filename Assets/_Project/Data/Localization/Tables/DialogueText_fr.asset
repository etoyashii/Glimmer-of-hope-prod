    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 19953703292686367
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 19953703292686368
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 19953703292686369
    m_Localized: "Qu\u2019aimerais-tu que les Phytos comprennent ?"
    m_Metadata:
      m_Items: []
  - m_Id: 19953703292686370
    m_Localized: "Et les r\xE9coltes des Phytos, tu as pu voir ce qui leur arrive
      ?"
    m_Metadata:
      m_Items: []
