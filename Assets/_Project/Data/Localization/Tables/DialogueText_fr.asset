      m_Items: []
  - m_Id: 20768449663258624
    m_Localized: "H\xE9, salut ! Moi, c\u2019est Lueur. Je connais quelques chemins
      par ici. Si tu veux, on peut explorer ensemble."
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395968
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395969
    m_Localized: "On est o\xF9, au juste ?"
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395970
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395971
    m_Localized: "Sur l\u2019Arbre-Monde. Il est si grand que des for\xEAts et des
      villages entiers y ont leur place."
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395972
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395973
    m_Localized: Des villages ? Ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395974
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395975
    m_Localized: "Oui ! Ce sentier m\xE8ne \xE0 l\u2019un d\u2019eux."
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395976
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395977
    m_Localized: "Tu vois cette st\xE8le, pr\xE8s du sentier ? Allons regarder."
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395978
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395979
    m_Localized: "Tiens, un tambour\u2026 Qu\u2019est-ce qu\u2019il fait l\xE0 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395980
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395981
    m_Localized: "Bonne question\u2026 Regarde les marques sur la st\xE8le : elles
      pourraient nous donner un indice."
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395982
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395983
    m_Localized: "Et si tu essayais d\u2019en jouer ?"
    m_Metadata:
      m_Items: []
  - m_Id: 20768449709395984
    m_Localized: 
    m_Metadata:
      m_Items: []
