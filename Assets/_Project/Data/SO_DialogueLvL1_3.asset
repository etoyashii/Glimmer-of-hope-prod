  - nodeId: f4923031
    nodeType: 0
    speakerId: Glow
    text: "This disease turns all matter dull and monochrome. It spreads so fast\u2026"
    bubblePrefab: {fileID: 8710288237247528408, guid: a05b9022f093e5146844401599d6884a, type: 3}
